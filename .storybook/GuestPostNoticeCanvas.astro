---
import GuestPostNotice from '../src/components/marketing/GuestPostNotice.astro';

interface Props {
  authorName?: string;
  authorUrl?: string;
  contributor?: boolean;
  theme?: 'light' | 'dark';
}

// Synthetic author data only. Contributor credit is an explicit editorial choice.
const { authorName = 'Fixture author', authorUrl, contributor } = Astro.props;
---

<main class="guest-post-canvas">
  <GuestPostNotice author={{ name: authorName, url: authorUrl }} contributor={contributor} />
</main>

<style>
  .guest-post-canvas {
    max-width: 50rem;
    margin: 2rem auto;
    padding: 0 1rem;
  }
</style>
