---
import { siGithub, siGodotengine, siSteam } from 'simple-icons';
import ActionLink from './marketing/ActionLink.astro';

type Icon = 'github' | 'godot' | 'steam';

interface Props {
  href: string;
  label: string;
  icon: Icon;
  accessibleLabel: string;
  variant?: 'primary' | 'secondary';
}

const { href, label, icon, accessibleLabel, variant = 'primary' } = Astro.props;
const icons = {
  github: siGithub,
  godot: siGodotengine,
  steam: siSteam,
};
const selectedIcon = icons[icon];
---

<ActionLink href={href} variant={variant === 'secondary' ? 'outline' : 'primary'} accessibleLabel={accessibleLabel}>
  <svg class="link-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path fill="currentColor" d={selectedIcon.path} />
  </svg>
  <span>{label}</span>
</ActionLink>
