---
interface Props {
  author: {
    name: string;
    url?: string;
  };
  contributor?: boolean;
}

const { author, contributor = false } = Astro.props;
---

<aside class="guest-post-notice" aria-label="Guest post">
  <p>This is a guest post by {author.url ? <a href={author.url} rel="author"><strong>{author.name}</strong></a> : <strong>{author.name}</strong>}, a GDZig community member{contributor ? ' and contributor' : ''}.</p>
</aside>

<style>
  .guest-post-notice {
    min-width: 0;
    margin-block: 0 1.5rem;
    padding: .25rem 0 .25rem 1rem;
    border-inline-start: 3px solid var(--gdzig-accent-background);
    color: var(--gdzig-muted);
    font-size: .9rem;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }

  .guest-post-notice p {
    margin: 0;
    color: inherit;
    font-size: inherit;
  }
</style>
