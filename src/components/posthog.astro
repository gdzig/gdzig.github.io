---
const apiKey = import.meta.env.PUBLIC_POSTHOG_PROJECT_TOKEN;
const apiHost = import.meta.env.PUBLIC_POSTHOG_HOST;
const isDevelopment = import.meta.env.DEV;

if (import.meta.env.MODE !== 'development' && (!apiKey || !apiHost)) {
  throw new Error('PUBLIC_POSTHOG_PROJECT_TOKEN and PUBLIC_POSTHOG_HOST are required to build the site');
}
---

<script is:inline define:vars={{ apiKey, apiHost, isDevelopment }}>
  if (!apiKey || !apiHost) {
    if (isDevelopment) {
      console.error('Set PUBLIC_POSTHOG_PROJECT_TOKEN and PUBLIC_POSTHOG_HOST to enable analytics.');
    }
  } else {
