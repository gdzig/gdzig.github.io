---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import MarketingPage from '../../components/marketing/MarketingPage.astro';
import PageIntro from '../../components/marketing/PageIntro.astro';
import SectionHeading from '../../components/marketing/SectionHeading.astro';
import ShowcaseCard from '../../components/marketing/ShowcaseCard.astro';

const showcaseEntries = await getCollection('showcase');

const sections = [
  {
    id: 'games',
    title: 'Games',
    description: 'Built with GDZig',
    entries: showcaseEntries.filter((entry) => entry.data.category === 'games'),
  },
  {
    id: 'extensions',
    title: 'Extensions',
    description: 'Native plugins for Godot',
    entries: showcaseEntries.filter((entry) => entry.data.category === 'extensions'),
  },
].filter((section) => section.entries.length > 0);
---

<SiteLayout
  title="Made with GDZig | GDZig"
  description="Community projects built with GDZig."
>
  <MarketingPage background="pattern">
    <PageIntro
      slot="intro"
      id="showcase-title"
      title="Made with GDZig"
      eyebrow="Community projects"
      description="Games, tools, and Godot extensions that use GDZig."
    />
    <div class="container marketing-sections">
      {sections.map((section) => (
        <section aria-labelledby={`${section.id}-title`}>
          <SectionHeading id={`${section.id}-title`} title={section.title} description={section.description} />
          <div class="grid showcase-grid">
            {section.entries.map((entry) => <ShowcaseCard project={entry.data} />)}
          </div>
        </section>
      ))}
    </div>
  </MarketingPage>
</SiteLayout>
