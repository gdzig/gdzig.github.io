{
  "name": "@gdzig/site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "astro dev",
    "test": "bun test",
    "test:browser:prose": "bun run test/browser/blog-prose.ts",
    "test:browser:copy": "bun run test/browser/blog-copy.ts",
    "build": "bun run scripts/build.ts",
    "build:astro": "astro build",
    "preview": "astro preview",
    "storybook": "storybook dev --host 127.0.0.1 --port 6006 --no-open --disable-telemetry",
    "build-storybook": "storybook build --disable-telemetry",
    "test:bdd:generate": "bddgen --config playwright.config.ts",
    "test:bdd": "bun run test:bdd:generate && playwright test --config playwright.config.ts"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.2",
    "@fontsource/inter": "5.3.0",
    "@fontsource/noto-sans-math": "5.3.0",
    "@picocss/pico": "2.1.1",
    "astro": "^7.3.3",
    "satori": "0.26.0",
    "sharp": "^0.35.3",
    "simple-icons": "^16.32.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@storybook-astro/framework": "1.14.0",
    "@storybook/builder-vite": "10.6.5",
    "playwright-bdd": "9.2.1",
    "storybook": "10.6.5"
  }
}
